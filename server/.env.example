# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MobileAPI.dev Configuration
# When USE_MOCK=true or MOBILEAPI_KEY is not set, server runs entirely in local Mock Mode using fixtures
USE_MOCK=true
MOBILEAPI_KEY=

# Cache Settings (in milliseconds)
CACHE_SEARCH_TTL_MS=300000
CACHE_DETAIL_TTL_MS=3600000
CACHE_BRANDS_TTL_MS=86400000

# Assistant provider. Set to ollama to use the local Qwen model.
# mock is offline and deterministic.
AI_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=qwen3:8b
OLLAMA_MODEL=qwen3:8b
# Ollama: http://127.0.0.1:11434/v1
# LM Studio or another OpenAI-compatible server: http://127.0.0.1:1234/v1
LLM_BASE_URL=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=500
FINDER_CURRENCY=INR
